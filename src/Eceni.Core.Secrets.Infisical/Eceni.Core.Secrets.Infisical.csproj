<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Eceni.Core.Secrets.Infisical</RootNamespace>
		<Configurations>Debug;Release</Configurations>
		<IsPackable>true</IsPackable>
		<PackageId>Eceni.Core.Secrets.Infisical</PackageId>
		<Description>Infisical provider for Eceni.Core.Secrets</Description>
		<Authors>dazzknowles</Authors>
		<RepositoryUrl>https://github.com/dazzknowles/eceni.core</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Infisical.Sdk" Version="3.0.4" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Eceni.Core.Secrets\Eceni.Core.Secrets.csproj" />
	</ItemGroup>

</Project>
